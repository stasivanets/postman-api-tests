{
  "info": {
    "_postman_id": "bdab989b-3c75-49d4-b515-491268cecc45",
    "name": "JSONPlaceholder Practice Suite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "16775282"
  },
  "item": [
    {
      "name": "1. Verify Target User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {\n    pm.response.to.have.status(200);\n    const data = pm.response.json();\n    pm.environment.set(\"userEmail\", data.email);\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/{{targetUserId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{targetUserId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. Create Post",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.iterationData.get(\"title\")) {\n    pm.variables.set(\"title\", \"Fallback Title\");\n    pm.variables.set(\"body\", \"Fallback Body Content\");\n    pm.variables.set(\"userId\", 1);\n}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"{{title}}\",\n  \"body\": \"{{body}}\",\n  \"userId\": \"{{userId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. Add Comment",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Comment attached successfully\", function () {\n    pm.response.to.have.status(201);\n    const data = pm.response.json();\n    pm.expect(data.email).to.eql(pm.environment.get(\"userEmail\"));\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"postId\": {{postId}},\n  \"name\": \"QA Tester\",\n  \"email\": \"{{userEmail}}\",\n  \"body\": \"Testing dynamic chaining in Postman UI!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/comments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "comments"
          ]
        }
      },
      "response": []
    }
  ]
}