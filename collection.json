{
  "info": {
    "_postman_id": "4ef6b519-5d0e-4692-b5e7-f05831292bbc",
    "name": "Capstone E2E API Suite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "16775282"
  },
  "item": [
    {
      "name": "POST /auth/login (Token Generation)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Auth successful - Token acquired\", function () {\n    pm.response.to.have.status(200);\n    const response = pm.response.json();\n    pm.expect(response).to.have.property(\"accessToken\");\n    \n    // Save dynamic Bearer token and authenticated userId\n    pm.environment.set(\"authToken\", response.accessToken);\n    pm.environment.set(\"capstoneUserId\", response.id);\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{authUsername}}\",\n  \"password\": \"{{authPassword}}\",\n  \"expiresInMins\": 30\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET /auth/me",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Token is valid - Profile retrieved\", function () {\n    pm.response.to.have.status(200);\n    const response = pm.response.json();\n    pm.expect(response.id).to.eql(pm.environment.get(\"capstoneUserId\"));\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        }
      },
      "response": []
    },
    {
      "name": "POST /carts/add",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Cart created successfully\", function () {\n    pm.response.to.have.status(201);\n    const response = pm.response.json();\n    \n    // Save generated Cart ID (or fallback to valid DB ID for DummyJSON mock limitations)\n    const createdCartId = response.id > 50 ? 1 : response.id;\n    pm.environment.set(\"capstoneCartId\", createdCartId);\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": {{capstoneUserId}},\n  \"products\": [\n    { \"id\": 1, \"quantity\": 2 },\n    { \"id\": 2, \"quantity\": 1 }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/carts/add",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "carts",
            "add"
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET /carts/{{capstoneCartId}}",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Cart state matches created resource\", function () {\n    pm.response.to.have.status(200);\n    const response = pm.response.json();\n    pm.expect(response).to.have.property(\"products\");\n    pm.expect(response.products.length).to.be.above(0);\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/carts/{{capstoneCartId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "carts",
            "{{capstoneCartId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "DELETE /carts/{{capstoneCartId}}",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Cart marked as deleted\", function () {\n    pm.response.to.have.status(200);\n    const response = pm.response.json();\n    pm.expect(response.isDeleted).to.be.true;\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/carts/{{capstoneCartId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "carts",
            "{{capstoneCartId}}"
          ]
        }
      },
      "response": []
    }
  ]
